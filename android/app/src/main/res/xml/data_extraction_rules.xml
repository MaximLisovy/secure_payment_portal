<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of this app goes to a cloud backup or to another device. It keeps no
     data worth moving; excluding every domain keeps it that way if a cache is added later.
     android:allowBackup="false" says the same for Android 11 and below. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
